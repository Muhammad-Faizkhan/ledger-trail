# Copy to .env.local for local dev. In production set these in Vercel project settings.
# Values come from Firebase console > Project settings > Your apps > Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "true" points the app at the local Firebase Emulator Suite (npm run emulators).
# With emulators, PROJECT_ID must be demo-ledgertrail and the other values can be anything.
NEXT_PUBLIC_USE_EMULATORS=false

# Production only (Vercel): lets the server routes in src/app/api write to Firestore.
# Firebase console > Project settings > Service accounts > Generate new private key,
# then paste the whole JSON file as this one value. Never commit it. Not needed with emulators.
FIREBASE_SERVICE_ACCOUNT_KEY=
