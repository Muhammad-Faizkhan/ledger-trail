{
  "name": "ledgertrail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "emulators": "npm --prefix functions run build && firebase emulators:start",
    "seed": "tsx scripts/seed-emulator.ts",
    "test:unit": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules.test.ts\"",
    "test:e2e": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions \"vitest run tests/e2e.test.ts\"",
    "test": "npm run test:unit && npm run test:rules && npm run test:e2e"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
